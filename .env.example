APP_NAME="Cartoon Shorts Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cartoon_studio
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MEDIA_DISK=media-private

# Phase 6 rendering (D-008): explicit binary paths — never assumed on PATH.
# Example Windows install (gyan.dev build): FFMPEG_BINARY=C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_BINARY=
FFPROBE_BINARY=
FFMPEG_TIMEOUT_SECONDS=1800
FFPROBE_TIMEOUT_SECONDS=60

# Optional encoder knobs — the output contract (H.264/AAC, 1080x1920, 30 fps,
# +faststart) is enforced independently of these values.
FFMPEG_X264_PRESET=veryfast
FFMPEG_CRF=23
FFMPEG_AUDIO_BITRATE=192k
FFMPEG_AUDIO_SAMPLE_RATE=48000
FFMPEG_TRANSITION_SECONDS=0.5
FFMPEG_MUSIC_VOLUME=0.25
FFMPEG_SFX_VOLUME=0.5
FFMPEG_LOUDNESS_I=-16
FFMPEG_LOUDNESS_TP=-1.5
FFMPEG_LOUDNESS_LRA=11
FFMPEG_MIN_FREE_DISK_MB=500
FFMPEG_GATE_DURATION_TOLERANCE=1.0
FFMPEG_GATE_MAX_BLACKNESS=8
FFMPEG_THUMBNAIL_SCALE=0.5
FFMPEG_TEMP_MAX_AGE_HOURS=24
FFMPEG_TEMP_DIR=                        # default: storage_path('app/rendering')
FFMPEG_ANIMATION_ENABLED=true           # layered zoompan motion for STILL-mode renders only (AI animated clips ignore it)

# Speech-bubble pre-render font (TTF). Empty = bundled OFL Noto Sans
# (resources/fonts/NotoSans-Regular.ttf, see LICENSE-NotoSans.txt).
FFMPEG_BUBBLE_FONT=
FFMPEG_BUBBLE_FONT_SCALE=2.0

PROVIDER_CREDENTIAL_STORE=env
TEXT_PROVIDER=
TEXT_MODEL=
TEXT_API_KEY=
IMAGE_PROVIDER=
IMAGE_MODEL=
IMAGE_API_KEY=
TTS_PROVIDER=
TTS_MODEL=
TTS_API_KEY=
MUSIC_PROVIDER=                  # AI music stays disabled (Phase 5: no verified licensing terms)
MUSIC_MODEL=
MUSIC_API_KEY=

# One-click full-video pipeline (GenerateFullVideoJob) stage tuning:
PIPELINE_POLL_INTERVAL_SECONDS=5
PIPELINE_STAGE_TIMEOUT_SECONDS=1800
PIPELINE_STAGE_RETRIES=1

# ---------------------------------------------------------------------------
# AI scene video providers (VIDEO_GENERATION_AI.md). Set VIDEO_PROVIDER to
# runway | replicate. Each provider ships a verified default model
# (replicate: wan-video/wan-2.5-i2v-fast; runway: veo3.1_fast). Both vendors
# delete generated files after a short window — the pipeline downloads clips
# immediately and never persists provider URLs as assets.
# ---------------------------------------------------------------------------
VIDEO_PROVIDER=
VIDEO_MODEL=
VIDEO_API_KEY=

# Replicate (primary scene-video + youthful-voice provider; verified
# 2026-11-01 against replicate.com official model pages):
#   scene video models: wan-video/wan-2.5-i2v-fast (default, $0.068/s 720p),
#                       google/veo-3-fast ($0.15/s with audio),
#                       kwaivgi/kling-v2.1 ($0.05/s silent),
#                       bytedance/seedance-1-pro ($0.06/s 720p silent),
#                       minimax/hailuo-02 (flat per clip)
#   speech model:       minimax/speech-02-turbo ($0.06 / 1k input tokens);
#                       youthful-leaning system voices — labeled unverified
#                       until real samples pass review
REPLICATE_BASE_URL=https://api.replicate.com/v1
REPLICATE_POLL_INTERVAL_SECONDS=10
REPLICATE_POLL_TIMEOUT_SECONDS=600
REPLICATE_TTS_VERSION=f39649380c14fcc2263e2cc4f27d112629b72e95d7c5a8e5eb23bd90444fd34c
REPLICATE_TTS_DEFAULT_VOICE=English_CaptivatingStoryteller
REPLICATE_TTS_RESPONSE_FORMAT=wav
REPLICATE_TTS_SYNC_WAIT_SECONDS=60
REPLICATE_TTS_POLL_INTERVAL_SECONDS=2
REPLICATE_TTS_POLL_TIMEOUT_SECONDS=120

# Runway Dev aggregation (verified 2026-10-31; credits are $0.01 each):
#   models: veo3.1_fast (default), kling3.0_standard, wan3, gen4_turbo, gen4.5
RUNWAY_BASE_URL=https://api.dev.runwayml.com/v1
VIDEO_POLL_INTERVAL_SECONDS=10
VIDEO_POLL_TIMEOUT_SECONDS=600

# OpenAI text adapter (D-007). TEXT_MODEL defaults to gpt-6.1-terra.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STORE_RESPONSES=false
OPENAI_TEXT_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS_STORY=4000
OPENAI_MAX_OUTPUT_TOKENS_PLAN=6000
OPENAI_MAX_OUTPUT_TOKENS_METADATA=1000

# OpenAI image adapter (D-007 image portion). IMAGE_MODEL defaults to
# gpt-image-2.5-flare (documented snapshot: gpt-image-2.5-flare-2026-09-08).
OPENAI_IMAGE_SIZE_CHARACTER=1024x1024
OPENAI_IMAGE_SIZE_SCENE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_OUTPUT_FORMAT=png

# OpenAI speech adapter (D-007 tts portion). TTS_MODEL defaults to
# gpt-4o-mini-tts (documented snapshot: gpt-4o-mini-tts-2025-12-15).
# Documented built-in voices: alloy ash ballad coral echo fable onyx nova
# sage shimmer verse marin cedar (empty voice => default fallback "alloy").
# NOTE: the verified Speech-API models are deprecated with shutdown on
# 2027-01-06; the documented replacement (gpt-realtime-2.1-mini) uses the
# Realtime API and will require a future adapter change.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_DEFAULT_VOICE=alloy
OPENAI_TTS_RESPONSE_FORMAT=wav

DAILY_PROVIDER_BUDGET_USD=
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RATE_VERSION=2026-10-29        # bump + re-run cost:snapshot-rates together with a verified price change
PROVIDER_BACKOFF_BASE_MS=500
PROVIDER_BACKOFF_MAX_MS=30000
PROVIDER_TIMEOUT_TEXT_SECONDS=60
PROVIDER_TIMEOUT_IMAGE_SECONDS=300
PROVIDER_TIMEOUT_TTS_SECONDS=300
PROVIDER_TIMEOUT_MUSIC_SECONDS=300
PROVIDER_LOG_CHANNEL=
MAX_AUDIO_UPLOAD_MB=20

# Measured infrastructure rates for the admin cost analytics (USD; 0 = not
# measured — reports show null/zero rather than guessing):
COST_RENDER_PER_WALL_SECOND_USD=
COST_STORAGE_PER_GB_MONTH_USD=
COST_BANDWIDTH_PER_GB_USD=

VITE_APP_NAME="${APP_NAME}"
