APP_NAME="Cartoon Shorts Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cartoon_studio
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MEDIA_DISK=media-private

FFMPEG_BINARY=
FFPROBE_BINARY=
FFMPEG_TIMEOUT_SECONDS=1800

PROVIDER_CREDENTIAL_STORE=env
TEXT_PROVIDER=
TEXT_MODEL=
TEXT_API_KEY=
IMAGE_PROVIDER=
IMAGE_MODEL=
IMAGE_API_KEY=
TTS_PROVIDER=
TTS_MODEL=
TTS_API_KEY=
MUSIC_PROVIDER=
MUSIC_MODEL=
MUSIC_API_KEY=

DAILY_PROVIDER_BUDGET_USD=
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BACKOFF_BASE_MS=500
PROVIDER_BACKOFF_MAX_MS=30000
PROVIDER_TIMEOUT_TEXT_SECONDS=60
PROVIDER_TIMEOUT_IMAGE_SECONDS=300
PROVIDER_TIMEOUT_TTS_SECONDS=300
PROVIDER_TIMEOUT_MUSIC_SECONDS=300
PROVIDER_LOG_CHANNEL=
MAX_AUDIO_UPLOAD_MB=20

VITE_APP_NAME="${APP_NAME}"
